name: Compilar DS RSVP
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    container: devkitpro/devkitarm
    steps:
      - uses: actions/checkout@v4
      - name: Compilar
        run: |
          apt-get update && apt-get install -y unzip
          (dkp-pacman -S --noconfirm nds-dev || pacman -S --noconfirm nds-dev)
          unzip -q dsrsvp.zip
          cd dsrsvp
          make
      - uses: actions/upload-artifact@v4
        with:
          name: dsrsvp
          path: dsrsvp/dsrsvp.nds
